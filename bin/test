#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH << File.expand_path("../test", __dir__)

require "bundler/setup"

# If no files specified, add all test files to ARGV so rails/plugin/test loads them
ARGV.concat(Dir[File.expand_path("../test/**/*_test.rb", __dir__)]) if ARGV.empty?

require "rails/plugin/test"
